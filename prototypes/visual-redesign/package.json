{
  "name": "upgradeatlas-visual-prototypes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../apps/web/node_modules/vite/bin/vite.js --config vite.config.mjs",
    "build": "node ../../apps/web/node_modules/vite/bin/vite.js build --config vite.config.mjs",
    "preview": "node ../../apps/web/node_modules/vite/bin/vite.js preview --config vite.config.mjs",
    "test": "node --test tests/*.test.js && npm run typecheck",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "@gsap/react": "^2.1.2",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
