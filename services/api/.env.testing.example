# Example test environment configuration (safe to commit).
# Copy to .env.testing and fill in local values; never commit the real file.
#
# The test suite refuses to run against anything but PostgreSQL
# `upgradeatlas_test` (DECISIONS D16 fail-closed guard).

APP_NAME=Laravel
APP_ENV=testing
# Generate a local dev key: php artisan key:generate --show
APP_KEY=
APP_DEBUG=true

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=upgradeatlas_test
DB_USERNAME=upgradeatlas_app
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
